{
  "manifest_version": 3,
  "name": "Wasel Download Manager",
  "version": "1.1.0",
  "description": "Send links and optionally redirect browser downloads to Wasel Download Manager.",
  "permissions": ["activeTab", "downloads", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Send to Wasel",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wasel-download-manager@zerouki",
      "strict_min_version": "128.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
